<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules. The backup rule is empty since it's a prototype.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="."/>
        <exclude domain="file" path="device_specific/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>
